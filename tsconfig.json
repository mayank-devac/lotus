{
  "compilerOptions": {
    "outDir": "build",
    "target": "es2024",
    "module": "es2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "ESNext.Temporal"],
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": false,
    "forceConsistentCasingInFileNames": true,
    "rootDir": "src",
    "sourceMap": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false
  },
  "include": ["src/**/*.ts"]
}
